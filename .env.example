BOT_TOKEN=
ADMIN_IDS=123456789

MC_HOST=play.example.com
MC_PORT=25565
MC_VERSION=1.21.1

# В Docker путь внутри контейнера (compose уже прокидывает)
PROFILES_FOLDER=/app/data/profiles

RECONNECT_DELAY_MS=5000
PROXY_DOWN_RECONNECT_MS=60000
# Таймаут Microsoft auth / коннекта (мс), по умолчанию 12 минут
AUTH_TIMEOUT_MS=720000

# Кликер ПКМ по умолчанию (кликов в секунду, 1–20). Можно менять в панели на бота.
CLICKER_CPS=10
