{
  "name": "funtime-bot-panel",
  "version": "1.0.0",
  "description": "FunTime cracked (offline) mineflayer bots with Telegram panel",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f bot",
    "docker:restart": "docker compose restart bot"
  },
  "license": "ISC",
  "dependencies": {
    "axios": "^1.19.0",
    "better-sqlite3": "^12.8.0",
    "dotenv": "^16.6.1",
    "flayercaptcha": "^1.0.6",
    "grammy": "^1.44.0",
    "mineflayer": "^4.37.1",
    "socks": "^2.8.4",
    "socks-proxy-agent": "^10.1.0",
    "undici": "^8.9.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
